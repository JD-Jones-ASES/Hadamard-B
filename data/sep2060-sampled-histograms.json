{
 "schema": "sampled-abs-t4-histograms/1",
 "description": "Sampled |T4| 4-profile histograms for the two order-2060 matrices, row side and column side, from two INDEPENDENT samplers. This is COMPUTATIONAL EVIDENCE, never a proof: a sampled 4-profile can corroborate a separation but can never establish one.",
 "n": 2060,
 "statistic": "|T4| over uniformly random row (resp. column) 4-subsets; T4 = sum_c H[i][c]H[j][c]H[k][c]H[l][c], computed EXACTLY per drawn 4-subset",
 "FOLD_WARNING": "SIGNED T4 is NOT a Hadamard-equivalence invariant; only |T4| is. The source bank's implementation-A reports carry the SIGNED histogram under the innocuous legacy key '<side>_sampled_T4'. Every A-side histogram below has been FOLDED to |T4| by summing the +k and -k bins, exactly as the lab's summarize.py sampled_abs() does. No negative bin survives anywhere in this file, and cert 07 asserts that on load. Comparing the raw signed key manufactures a 7-sigma false separation on a PROVABLY EQUIVALENT pair -- that is the trap this fold closes.",
 "provenance": {
  "source_bank": "Hadamard-2060 (lab) scratch/inequiv/, the turn-43 invariant sweep of 2026-08-31, deliberately left byte-identical as a provenance record",
  "impl_A": {
   "file_pattern": "invA_2060-<tag>.json",
   "key_read": "<side>_sampled_T4  (LEGACY, SIGNED)",
   "folded_from_legacy": true,
   "samples_per_matrix_per_side": 20000000,
   "rng_seed": 20260831,
   "generator": "experiments/inequiv/inv_a.py --blocks 3 --samples 20000000"
  },
  "impl_B": {
   "file_pattern": "invB_2060-<tag>.json",
   "key_read": "<side>_sampled_absT4  (already |T4|)",
   "folded_from_legacy": false,
   "samples_per_matrix_per_side": 3000000,
   "rng_seed": 831026,
   "generator": "experiments/inequiv/inv_b.py --blocks 3 --shard-bits 3 --samples 3000000 --spot 3000"
  },
  "independence": "A and B use opposite bit-packing conventions, different canonicalisation, different RNGs and different seeds; B additionally carries a direct-summation spot path over the +/- strings with no packing and no popcount"
 },
 "z_statistic": "per bin k with p + q >= 200: e = (p+q)/2, z = |p - q| / sqrt(2e); bins with p + q < 200 are not compared. This is the lab summarize.py statistic.",
